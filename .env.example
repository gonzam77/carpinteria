# ---------------------------------------------------------------------------
# Variables que lee docker-compose.yml. Copiar a .env en la raiz antes de
# 'docker compose up' (cp .env.example .env). El backend corriendo fuera de
# Docker NO usa este archivo: usa backend/.env.
# ---------------------------------------------------------------------------

# Base de datos. Estas tres arman a la vez el contenedor 'db' y el DATABASE_URL
# que compose le pasa a la API, asi que alcanza con tocarlas aca.
# Postgres solo aplica POSTGRES_PASSWORD cuando CREA el volumen: si la base ya
# existe, cambiarla aca no cambia la clave real (hace falta 'docker compose
# down -v', que borra los datos, o un ALTER USER a mano).
# Si la clave lleva @ : / o ? hay que percent-encodearla o la URL se rompe.
POSTGRES_DB=carpinteria
POSTGRES_USER=carpinteria
POSTGRES_PASSWORD=change-me

# Compose NO lee DATABASE_URL de aca: lo construye con las tres variables de
# arriba. Queda comentado solo como referencia para conectarse a mano desde la
# maquina, donde el puerto publicado es 5433 y no 5432.
# DATABASE_URL=postgresql://carpinteria:change-me@localhost:5433/carpinteria?schema=public

# API
JWT_SECRET=change-me-at-least-16-characters
JWT_EXPIRES_IN=8h
# Tope absoluto de una sesion en horas: pasado ese tiempo hay que volver a
# ingresar aunque se la venga renovando.
SESSION_MAX_HOURS=24
# Horas despues de vencido en que un token todavia se puede renovar (el celular
# que durmio con la app abierta). Nunca supera SESSION_MAX_HOURS.
REFRESH_GRACE_HOURS=12
# Origen exacto del frontend, SIN barra final: la API compara el header Origin
# entero contra esta lista. Si hay varios van separados por coma.
FRONTEND_URL=https://roma.devgm.com.ar

# Frontend (se hornean en el build de la imagen web)
VITE_API_URL=/api

# Google Login: el backend valida el token contra el mismo client id que usa el
# frontend, tienen que ser iguales.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# WhatsApp (opcional: sin token no se mandan avisos)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=5492664489645

# Push web (opcional: sin las claves VAPID no se registran suscripciones)
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@carpinteria.local

