generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  CARPINTERO
  OPERARIO
  EMPLEADO
}

enum EstadoPedido {
  PENDIENTE
  EN_PROCESO
  TERMINADA
  ENTREGADA
  RECHAZADA
}

enum TipoMaterial {
  PLACA
  CANTO
}

model Usuario {
  id                String             @id @default(uuid())
  nombre            String
  apellido          String
  email             String             @unique
  password          String?
  telefono          String?
  googleId          String?            @unique
  rol               Rol                @default(CARPINTERO)
  fechaCreacion     DateTime           @default(now())
  pedidos           Pedido[]
  auditorias        Auditoria[]        @relation("AuditoriaUsuario")
  cambios           HistorialPedido[]  @relation("CambioUsuario")
  pushSubscriptions PushSubscription[]

  @@map("usuarios")
}

model Pedido {
  id                  String            @id @default(uuid())
  cliente             String
  numeroContacto      String?
  observaciones       String?
  estado              EstadoPedido      @default(PENDIENTE)
  stockReservado      Boolean           @default(false)
  placasEstimadas     Int               @default(0)
  costoPlacas         Float             @default(0)
  costoManoObraCortes Float             @default(0)
  costoMaterialCantos Float             @default(0)
  costoPegadoCantos   Float             @default(0)
  costoCantos         Float             @default(0)
  metrosCanto         Float             @default(0)
  presupuestoEstimado Float             @default(0)
  faltanteStock       Boolean           @default(false)
  // Detalle del calculo con el que se armo la constancia: placas por material, mm por canto, y los precios
  // y la configuracion usados. Lo leen el listado de materiales y el dashboard. Null en pedidos anteriores.
  estimacionDetalle   Json?
  // Stock comprometido por el pedido: las placas por material que se descontaron, para devolver exactamente
  // eso. forzada = se avanzo sin descontar. Null si no tiene stock comprometido (o en pedidos anteriores).
  reservaStock        Json?
  // Numero correlativo legible (spec D6). Las solicitudes de modulos se muestran como M-{numero}.
  numero              Int               @unique @default(autoincrement())
  tipo                TipoPedido        @default(CORTE)
  fechaEntrega        DateTime?         @db.Date // fecha comprometida, sin hora (DECISIONES 8)
  emailContacto       String?
  direccionEntrega    String?
  costoHerrajes       Float             @default(0) // aparte de presupuestoEstimado (DECISIONES R1)
  // Clave de alta del asistente de modulos (UUID del navegador, DECISIONES 40): si el mismo intento llega dos veces,
  // se devuelve la solicitud ya creada en vez de crear otra.
  claveAlta           String?           @unique
  usuarioId           String
  fechaCreacion       DateTime          @default(now())
  fechaActualizacion  DateTime          @updatedAt
  usuario             Usuario           @relation(fields: [usuarioId], references: [id])
  detalles            DetallePedido[]
  historial           HistorialPedido[]
  modulos             PedidoModulo[]
  herrajes            PedidoHerraje[]

  @@index([estado])
  @@index([tipo])
  @@index([fechaEntrega])
  @@index([cliente])
  @@index([fechaCreacion])
  @@map("pedidos")
}

model Material {
  id                          String                 @id @default(uuid())
  nombre                      String                 @unique
  tipo                        TipoMaterial           @default(PLACA)
  valor                       Float
  espesorMm                   Float                  @default(18)
  anchoPlaca                  Int?
  altoPlaca                   Int?
  colorCanto                  String?
  placaMaterialId             String?
  stockPlacas                 Int?
  activo                      Boolean                @default(true)
  fechaCreacion               DateTime               @default(now())
  fechaActualizacion          DateTime               @updatedAt
  detalles                    DetallePedido[]
  placaMaterial               Material?              @relation("CantoPlaca", fields: [placaMaterialId], references: [id], onDelete: SetNull)
  cantos                      Material[]             @relation("CantoPlaca")
  modulosFondo                Modulo[]               @relation("ModuloFondo")
  piezasModuloFijas           ModuloPieza[]          @relation("ModuloPiezaFijo")
  configuracionesModulosFondo ConfiguracionModulos[] @relation("ConfiguracionModulosFondo")
  pedidosModuloEsqueleto      PedidoModulo[]         @relation("PMEsqueleto")
  pedidosModuloFrentes        PedidoModulo[]         @relation("PMFrentes")
  pedidosModuloFondo          PedidoModulo[]         @relation("PMFondo")

  @@index([tipo])
  @@index([activo])
  @@index([placaMaterialId])
  @@map("materiales")
}

model DetallePedido {
  id                String         @id @default(uuid())
  pedidoId          String
  materialId        String?
  codigoBarra       String
  material          String
  largo             Int
  ancho             Int
  cantidad          Int
  cantoLargo1Id     String?
  cantoLargo1Nombre String?
  cantoLargo1       Boolean        @default(false)
  cantoLargo2Id     String?
  cantoLargo2Nombre String?
  cantoLargo2       Boolean        @default(false)
  cantoAncho1Id     String?
  cantoAncho1Nombre String?
  cantoAncho1       Boolean        @default(false)
  cantoAncho2Id     String?
  cantoAncho2Nombre String?
  cantoAncho2       Boolean        @default(false)
  permiteRotar      Boolean        @default(false)
  codigoBarraCentro String?
  remark            String?
  numeroCliente     String?
  nombreCliente     String?
  nombreProducto    String?
  // Posicion de la fila dentro del pedido. Todas las lecturas ordenan por este campo.
  indice            Int            @default(0)
  pedidoModuloId    String? // null = pieza de corte normal o "pieza adicional" de una solicitud de modulos
  piezaCodigo       String? // codigo de ModuloPieza de donde salio (null si es MANUAL)
  origen            OrigenDetalle? // null en solicitudes de corte
  orden             Int            @default(0) // orden de la pieza dentro de su modulo (DECISIONES 11)
  pedido            Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoModulo      PedidoModulo?  @relation(fields: [pedidoModuloId], references: [id], onDelete: Cascade)
  materialRef       Material?      @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([materialId])
  @@index([pedidoId, indice])
  @@index([pedidoModuloId])
  @@map("detalle_pedidos")
}

model HistorialPedido {
  id            String   @id @default(uuid())
  pedidoId      String
  usuarioId     String
  accion        String
  valorAnterior String?
  valorNuevo    String?
  fechaCreacion DateTime @default(now())
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuario       Usuario  @relation("CambioUsuario", fields: [usuarioId], references: [id])

  @@index([pedidoId])
  @@map("historial_pedidos")
}

model Auditoria {
  id            String   @id @default(uuid())
  usuarioId     String?
  accion        String
  entidad       String
  entidadId     String?
  metadata      Json?
  fechaCreacion DateTime @default(now())
  usuario       Usuario? @relation("AuditoriaUsuario", fields: [usuarioId], references: [id])

  @@index([entidad])
  @@map("auditorias")
}

model ConfiguracionOptimizador {
  id                 String   @id @default("default")
  espesorSierraMm    Float    @default(4.3)
  perfiladoBordeMm   Int      @default(10)
  fechaActualizacion DateTime @updatedAt

  @@map("configuracion_optimizador")
}

model ConfiguracionEmpresa {
  id                 String   @id @default("default")
  nombre             String   @default("ROMA")
  telefono           String   @default("")
  email              String   @default("")
  fechaActualizacion DateTime @updatedAt

  @@map("configuracion_empresa")
}

model ConfiguracionPresupuesto {
  id                    String   @id @default("default")
  manoObraCanto045Mm    Float    @default(0)
  manoObraCanto1Mm      Float    @default(0)
  manoObraCanto2Mm      Float    @default(0)
  manoObraPlacaPorPlaca Float    @default(0)
  fechaActualizacion    DateTime @updatedAt

  @@map("configuracion_presupuesto")
}

model PushSubscription {
  id                 String   @id @default(uuid())
  endpoint           String   @unique
  p256dh             String
  auth               String
  userAgent          String?
  usuarioId          String
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
  usuario            Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------- Modulos a medida: catalogo (F2.1)
// Especificacion: docs/modulos/ESPECIFICACION-MODULOS-A-MEDIDA.md §5. Las relaciones con los pedidos
// (PedidoModulo y PedidoHerraje) se agregan en la migracion de pedidos (F2.2).

enum TipoParametroModulo {
  MEDIDA // mm, se pide al cargar (ANCHO, ALTO, PROFUNDIDAD, LUZ_ABAJO...)
  ENTERO // cantidad entera que se pide al cargar (ej. ESTANTES)
  OPCION // lista de opciones numeradas (ej. VARIANTE_FONDO)
  CALCULADO // no se pide; se calcula con una formula (ej. LUZ_ARRIBA en Torre horno)
}

enum RolPiezaModulo {
  ESQUELETO // toma el color de esqueleto de la solicitud
  FRENTE // toma el color de frentes
  FONDO // toma el material de fondo (del modulo o de ConfiguracionModulos)
  FIJO // usa siempre ModuloPieza.materialFijoId
}

enum LadoCanto {
  LARGO_1
  LARGO_2
  ANCHO_1
  ANCHO_2
}

model CategoriaModulo {
  id      String   @id @default(uuid())
  nombre  String   @unique
  orden   Int      @default(0)
  activo  Boolean  @default(true)
  modulos Modulo[]

  @@map("categorias_modulo")
}

model Modulo {
  id                 String              @id @default(uuid())
  codigo             String              @unique // UPPER_SNAKE, ej. BAJO_MESADA_2_PUERTAS
  nombre             String
  categoriaId        String
  descripcion        String?
  activo             Boolean             @default(true)
  espesorDisenoMm    Float               @default(18) // espesor con el que estan escritas las formulas
  materialFondoId    String? // si es null usa ConfiguracionModulos.materialFondoId
  observaciones      String? // notas internas (ej. las de importacion del Excel)
  version            Int                 @default(1) // +1 en cada guardado; se copia al snapshot
  fechaCreacion      DateTime            @default(now())
  fechaActualizacion DateTime            @updatedAt
  categoria          CategoriaModulo     @relation(fields: [categoriaId], references: [id])
  materialFondo      Material?           @relation("ModuloFondo", fields: [materialFondoId], references: [id], onDelete: SetNull)
  imagen             ModuloImagen?
  parametros         ModuloParametro[]
  piezas             ModuloPieza[]
  perfiles           ModuloPerfilCanto[]
  herrajes           ModuloHerraje[]
  pedidos            PedidoModulo[]

  @@index([categoriaId])
  @@index([activo])
  @@map("modulos")
}

// La imagen se guarda como archivo en UPLOADS_DIR, no en la base (decision de Gonzalo, DECISIONES 12).
model ModuloImagen {
  moduloId           String   @id
  mime               String // image/jpeg | image/png | image/webp
  archivo            String // nombre del archivo dentro de UPLOADS_DIR/modulos
  tamanoBytes        Int
  fechaActualizacion DateTime @updatedAt
  modulo             Modulo   @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@map("modulos_imagen")
}

model ModuloParametro {
  id           String              @id @default(uuid())
  moduloId     String
  clave        String // UPPER_SNAKE: ANCHO, ALTO, PROFUNDIDAD, LUZ_ABAJO...
  etiqueta     String
  tipo         TipoParametroModulo @default(MEDIDA)
  valorDefecto Float?
  minimo       Float?
  maximo       Float?
  opciones     Json? // OPCION: [{ "valor": 1, "etiqueta": "Fondo entero" }, ...]
  formula      String? // CALCULADO
  ayuda        String?
  orden        Int                 @default(0)
  modulo       Modulo              @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@unique([moduloId, clave])
  @@map("modulos_parametro")
}

model ModuloPieza {
  id              String             @id @default(uuid())
  moduloId        String
  codigo          String // UPPER_SNAKE unico dentro del modulo: PISO, LATERAL, PUERTAS...
  nombre          String // como sale en el Excel de maquina y en la hoja de taller
  rol             RolPiezaModulo     @default(ESQUELETO)
  materialFijoId  String? // obligatorio si rol = FIJO
  formulaLargo    String
  formulaAncho    String
  formulaCantidad String             @default("1")
  permiteRotar    Boolean            @default(false)
  orden           Int                @default(0)
  observaciones   String?
  modulo          Modulo             @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  materialFijo    Material?          @relation("ModuloPiezaFijo", fields: [materialFijoId], references: [id], onDelete: Restrict)
  cantos          ModuloPiezaCanto[]

  @@unique([moduloId, codigo])
  @@map("modulos_pieza")
}

model ModuloPerfilCanto {
  id             String             @id @default(uuid())
  moduloId       String
  nombre         String // "Estandar", "Economico"
  descripcion    String?
  orden          Int // 1 o 2 (maximo dos perfiles por modulo, validado en el servicio)
  predeterminado Boolean            @default(false) // exactamente uno por modulo
  modulo         Modulo             @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  lados          ModuloPiezaCanto[]

  @@unique([moduloId, orden])
  @@map("modulos_perfil_canto")
}

model ModuloPiezaCanto {
  id        String            @id @default(uuid())
  perfilId  String
  piezaId   String
  lado      LadoCanto
  espesorMm Float // 0.45 | 1 | 2
  perfil    ModuloPerfilCanto @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  pieza     ModuloPieza       @relation(fields: [piezaId], references: [id], onDelete: Cascade)

  @@unique([perfilId, piezaId, lado])
  @@map("modulos_pieza_canto")
}

model ConfiguracionModulos {
  id                   String    @id @default("default")
  materialFondoId      String? // material PLACA por defecto para piezas FONDO (DECISIONES 9: con clave foranea)
  redondeo             String    @default("REDONDEAR") // REDONDEAR | TRUNCAR
  diasEntregaDefecto   Int       @default(15)
  diasAvisoVencimiento Int       @default(3)
  herrajesHabilitados  Boolean   @default(false)
  fechaActualizacion   DateTime  @updatedAt
  materialFondo        Material? @relation("ConfiguracionModulosFondo", fields: [materialFondoId], references: [id], onDelete: SetNull)

  @@map("configuracion_modulos")
}

// Herrajes (opcional, detras de ConfiguracionModulos.herrajesHabilitados). Las tablas se crean igual.
// Tipo de herraje (bisagra, corredera, pata...): en el modulo y en la solicitud se elige un modelo de su tipo (DECISIONES 57).
model TipoHerraje {
  id                 String    @id @default(uuid())
  nombre             String    @unique
  orden              Int       @default(0)
  activo             Boolean   @default(true)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt
  herrajes           Herraje[]

  @@map("tipos_herraje")
}

// Un modelo de herraje, con su precio. Los que van por medida (correderas) llevan la medida en mm y una linea: los
// modelos del mismo tipo y la misma linea son las medidas de esa linea (DECISIONES 57).
model Herraje {
  id                 String          @id @default(uuid())
  nombre             String          @unique
  unidad             String          @default("unidad") // unidad | par | juego | metro
  valor              Float           @default(0)
  activo             Boolean         @default(true)
  tipoId             String?
  linea              String?
  medidaMm           Float?
  fechaCreacion      DateTime        @default(now())
  fechaActualizacion DateTime        @updatedAt
  tipo               TipoHerraje?    @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  modulos            ModuloHerraje[]
  pedidos            PedidoHerraje[]

  @@index([tipoId])
  @@map("herrajes")
}

model ModuloHerraje {
  id              String  @id @default(uuid())
  moduloId        String
  herrajeId       String
  formulaCantidad String // ej. "PUERTAS.cant * SI(PUERTAS.largo > 900; 3; 2)"
  // Medida que necesita (ej. "PROFUNDIDAD - 50"): se elige de la linea del modelo por defecto el mas largo que entra.
  formulaMedida   String?
  orden           Int     @default(0)
  modulo          Modulo  @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  herraje         Herraje @relation(fields: [herrajeId], references: [id], onDelete: Restrict)

  @@unique([moduloId, herrajeId])
  @@map("modulos_herraje")
}

// ---------------------------------------------------------------- Modulos a medida: solicitudes (F2.2)

enum TipoPedido {
  CORTE
  MODULOS
}

enum OrigenDetalle {
  CALCULADO // salio del motor sin cambios
  EDITADO // salio del motor y se modifico a mano
  MANUAL // se agrego a mano (en un modulo o como pieza adicional)
}

model PedidoModulo {
  id                 String          @id @default(uuid())
  pedidoId           String
  moduloId           String? // SetNull: si se borra el modulo del catalogo, la solicitud conserva el snapshot
  posicion           Int // 1..n: "Modulo 1", "Modulo 2"...
  nombreModulo       String // snapshot
  valores            Json // { "ANCHO": 1200, "ALTO": 780, "PROFUNDIDAD": 580 }
  colorEsqueletoId   String
  colorFrentesId     String
  // El canto de cada lado se elige por pieza (DECISIONES 45): queda en las filas (DetallePedido), no en el modulo.
  perfilCantoOrden   Int             @default(1)
  // Placa que usaron las piezas de fondo: la elegida en la solicitud o, si no se eligio, la del modulo o la de la
  // configuracion. Se guarda la usada, como los colores (DECISIONES 32). Null si el modulo no tiene piezas de fondo.
  materialFondoId    String?
  observaciones      String? // sale en la hoja de taller
  definicionSnapshot Json // copia completa del modulo usado (parametros, piezas, perfiles, herrajes, version)
  pedido             Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  modulo             Modulo?         @relation(fields: [moduloId], references: [id], onDelete: SetNull)
  colorEsqueleto     Material        @relation("PMEsqueleto", fields: [colorEsqueletoId], references: [id], onDelete: Restrict)
  colorFrentes       Material        @relation("PMFrentes", fields: [colorFrentesId], references: [id], onDelete: Restrict)
  materialFondo      Material?       @relation("PMFondo", fields: [materialFondoId], references: [id], onDelete: Restrict)
  detalles           DetallePedido[]
  herrajes           PedidoHerraje[]

  @@unique([pedidoId, posicion])
  @@index([moduloId])
  @@map("pedidos_modulo")
}

model PedidoHerraje {
  id             String         @id @default(uuid())
  pedidoId       String
  pedidoModuloId String?
  herrajeId      String?
  nombre         String // snapshot
  unidad         String
  tipo           String? // snapshot del nombre del tipo
  linea          String? // snapshot
  medidaMm       Float? // snapshot
  cantidad       Float
  valorUnitario  Float // snapshot del precio al crear o editar
  orden          Int            @default(0)
  origen         OrigenDetalle? // CALCULADO del catalogo, EDITADO a mano, MANUAL agregado a mano
  pedido         Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoModulo   PedidoModulo?  @relation(fields: [pedidoModuloId], references: [id], onDelete: Cascade)
  herraje        Herraje?       @relation(fields: [herrajeId], references: [id], onDelete: SetNull)

  @@map("pedidos_herraje")
}
