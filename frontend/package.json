{
  "name": "carpinteria-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "npm run test:cut-optimizer && npm run test:module-formula && npm run test:order-estimate && npm run test:image-compression && npm run test:module-editor && npm run test:module-order-wizard && npm run test:module-orders-list && npm run test:module-order-detail && npm run test:module-order-changes && npm run test:module-workshop && npm run test:hardware && npm run test:module-order-hardware",
    "test:cut-optimizer": "node --test --experimental-strip-types src/lib/cutOptimizer.test.ts",
    "test:module-formula": "node --test --experimental-strip-types src/lib/moduleFormula.test.ts",
    "test:order-estimate": "node --test --experimental-strip-types src/lib/orderEstimate.test.ts",
    "test:image-compression": "node --test --experimental-strip-types src/lib/imageCompression.test.ts",
    "test:module-editor": "node --test --experimental-strip-types src/lib/moduleEditor.test.ts",
    "test:module-order-wizard": "node --test --experimental-strip-types src/lib/moduleOrderWizard.test.ts",
    "test:module-orders-list": "node --test --experimental-strip-types src/lib/moduleOrdersList.test.ts",
    "test:module-order-detail": "node --test --experimental-strip-types src/lib/moduleOrderDetail.test.ts",
    "test:module-order-changes": "node --test --experimental-strip-types src/lib/moduleOrderChanges.test.ts",
    "test:module-workshop": "node --test --experimental-strip-types src/lib/moduleWorkshop.test.ts",
    "test:hardware": "node --test --experimental-strip-types src/lib/hardware.test.ts",
    "test:module-order-hardware": "node --test --experimental-strip-types src/lib/moduleOrderHardwareEdit.test.ts",
    "bench:optimizer": "node --experimental-strip-types --no-warnings src/lib/cutOptimizer.bench.ts",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.2.1",
    "@mui/material": "^6.2.1",
    "@mui/x-data-grid": "^7.23.5",
    "@react-oauth/google": "^0.12.2",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "file-saver": "^2.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
